@keyframes arrive { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
@media (max-width: 700px) {
  .hero { padding-top: 20px; }
  .hero-main { align-items: flex-start; flex-direction: column; gap: 34px; padding: 64px 0 42px; }
  h1 { font-size: clamp(50px, 15vw, 78px); }
  .hero-aside { width: auto; padding-left: 14px; }
  .hero-aside p { margin-top: 10px; }
  .hero-actions { flex-direction: column; align-items: flex-end; gap: 10px; }
  .site-nav { justify-content: flex-start; gap: 0; overflow-x: auto; }
  .site-nav a { flex: 0 0 auto; margin-right: 22px; }
  .resume-layout { grid-template-columns: 1fr; gap: 58px; padding-top: 58px; padding-bottom: 68px; }
  .resume-sidebar { gap: 42px; }
  .experience-item { grid-template-columns: 1fr; gap: 14px; padding: 24px 0 28px; }
  .experience-meta { justify-content: flex-start; gap: 15px; }
  .storage-list li { grid-template-columns: 1fr; }
  .footer-bottom { align-items: flex-start; flex-direction: column; gap: 9px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
}
